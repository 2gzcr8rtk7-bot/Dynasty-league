{
"id": "it114_0",
"lang": "i",
"voice": "im_nicola",
"speed": 1.15,
"text": "Signore e signori, siamo a bordo campo, e qui è una bolgia!"
},
{
"id": "it114_1",
"lang": "i",
"voice": "im_nicola",
"speed": 1.15,
"text": "Victor Wembanyama è semplicemente illegale! Trentasei punti, quattordici rimbalzi, sessantasette punti Dunkest! I Ducks fanno festa!"
},
{
"id": "it114_2",
"lang": "i",
"voice": "im_nicola",
"speed": 1.15,
"text": "Steph Curry, da un altro pianeta! Sei triple, quarantaquattro punti! Cinquantaquattro Dunkest per gli Eagles!"
},
{
"id": "it114_3",
"lang": "i",
"voice": "im_nicola",
"speed": 1.15,
"text": "Jokić? Tripla doppia, tanto per cambiare! Dolphins felicissimi!"
},
{
"id": "it114_4",
"lang": "i",
"voice": "im_nicola",
"speed": 1.15,
"text": "E attenzione, notte da incubo per Austin Reaves: appena due punti Dunkest! Foxes, che dolore!"
},
{
"id": "it114_5",
"lang": "i",
"voice": "im_nicola",
"speed": 1.15,
"text": "Linea alle immagini, ragazzi!"
},
